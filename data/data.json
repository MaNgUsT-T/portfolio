        "cards": [
            {
                "title": "Ästhetik trifft Funktion",
                "text": "Gutes Design ist unsichtbar. Ich gestalte interfaces, die nicht nur visuell ansprechend sind, sondern den Nutzer intuitiv an sein Ziel führen.",
                "icon": "tag"
            },
            {
                "title": "Struktur & Systeme",
                "text": "Ich liebe es. konsistente Design-Systeme aufzubauen. Skalierbare Komponenten und klare Typografie-Hierarchien sind das Fundament meiner Arbeit.",
                "icon": "layout"
            },
            {
                "title": "Nutzerzentriert",
                "text": "Der Nutzer steht immer im Mittelpunkt. Durch Research, Wireframing und Prototyping stelle ich sicher, dass echte Probleme gelöst werden.",
                "icon": "smartphone"
            }
        ]
    },
