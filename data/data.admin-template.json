          "row": false,
          "required": true,
          "errorRequired": "Bitte gib eine Nachricht ein."
        },
        {
          "label": "Interesse",
          "type": "radio",
          "name": "radio-group",
          "required": false,
          "errorRequired": "Bitte wähle ein Interesse aus.",
