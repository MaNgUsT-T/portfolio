          "row": true,
          "required": true,
          "errorRequired": "Bitte gib Betreff ein."
        },
        {
          "label": "Nachricht",
          "type": "textarea",
          "id": "message",
          "name": "message",
          "placeholder": "Erzähl mir von deinem Projekt..",
