# ===================================================================
# Kopiere diese Datei zu _docker/.env und fülle die Werte aus.
# Sensible lokale Umgebungsvariablen – Beispiel
# ===================================================================

# --- SSH/Remote-Export ---
# SSH-Zugang zum Server (für DB-Pull)
SSH_HOST=example.ssh.host
SSH_USER=example_user
SSH_PORT=22

# Live-DB-Zugänge (kanonisch für DB-Pull; werden lokal ggf. in MYSQL_* gespiegelt)
REMOTE_DB_HOST=dein.db.host
REMOTE_DB_NAME=dein.db.name
REMOTE_DB_USER=dein.db.user
REMOTE_DB_PASSWORD=dein.db.password

# Passwort für den 'root'-Benutzer der Datenbank. (ändern!)
MYSQL_ROOT_PASSWORD=bitte_aendern

# Lokale DB-Zugänge (optional). Wenn leer, leitet das Makefile sie aus REMOTE_DB_* ab.
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# --- Drittdienste / API Keys – Beispiel ---
# DRITTDIENST_API_KEY=
# DRITTDIENST_URL=https://example.drittdienst.io

# ===================================================================
# Unsensible lokale Umgebungsvariablen – Beispiel
# ===================================================================

# Host-UID/GID fuer Bind-Mount-Schreibrechte.
# Diese Werte werden in diesem Projekt zentral aus `_docker/.env` gelesen
# und von Makefile sowie `docker compose` gleich verwendet.
HOST_UID=1000
HOST_GID=1000

# Versionen
PHP_VERSION=8.3.30
WP_CLI_VERSION=2.12.0
DB_VERSION=10.11.15
APACHE_VERSION=2.4
PHPMYADMIN_VERSION=5.2.1

# Gemeinsamer PHP-Imagename (fuer php)
PHP_IMAGE=ionos-php

# Projektname
PROJECT_NAME=project_de

# URLs / Pfade
LIVE_URL=https://www.project.de
LOCAL_URL=http://project.local
LIVE_PATH=/xxx/xxxx/project
LOCAL_PATH=/var/www/html

# Reverse-Proxy-Hostnamen
VIRTUAL_HOST=project.local
PHPMYADMIN_HOST=pma.project.local

# ===================================================================
# Makefile-Flags (optionale Laufzeitsteuerung)
# 1 = an, 0 = aus
# ===================================================================

# Entfernt ungenutzte Docker-Images nach Build/Start-Zielen (`image-clean`).
CLEAN_IMAGES=1

# Entfernt zusaetzlich das PHP-Basisimage `php:<PHP_VERSION>-fpm` waehrend `image-clean`.
CLEAN_BASE_IMAGE=1

# Erzwingt `docker compose pull` fuer Proxy- und Prebuilt-Images statt "nur wenn fehlend".
PULL=0

# Erstellt den laufenden `php`-Container neu, wenn sich die verwendete Image-ID geaendert hat.
RECREATE_PHP=1
